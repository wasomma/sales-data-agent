# Copy to .env (git-ignored) and fill in. Never commit real keys.

# --- Credentials --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=

# --- Which backend answers questions ------------------------------------------
# replay      : serve demo/recording.json, never call a model (what the public
#               demo runs on). Needs no database and no credentials.
# api         : call a model directly with an API key (see SALES_AGENT_PROVIDER)
# agy         : headless Antigravity CLI, on the work Gemini subscription
# claude-code : headless Claude Code, on a Claude subscription (the default)
# SALES_AGENT_BACKEND=api

# --- Which provider the 'api' backend uses ------------------------------------
# claude (default) or gemini. SALES_AGENT_PROVIDER=gemini with GEMINI_API_KEY
# set is enough on its own — SALES_AGENT_BACKEND does not also need setting.
# SALES_AGENT_PROVIDER=gemini

# --- Optional overrides -------------------------------------------------------
# SALES_AGENT_MODEL=claude-opus-5
# SALES_AGENT_GEMINI_MODEL=gemini-2.5-pro
# SALES_AGENT_AGY_MODEL=gemini-3.1-pro-high
# SALES_AGENT_DATA_DIR=./data
